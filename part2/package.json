{
  "name": "part2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "FoodGroups REST API — Express + PostgreSQL backend for the part1 frontend",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && node -e \"require('fs').cpSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
