# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foodgroups

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long an issued token stays valid
JWT_EXPIRES_IN=7d

PORT=4000

# Comma-separated origins allowed to call the API (the part1 dev server)
CORS_ORIGIN=http://localhost:5173

# Max Postgres connections in the pool
PG_POOL_MAX=10
